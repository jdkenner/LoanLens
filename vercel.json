{
  "outputDirectory": "Public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/([^.]+)", "dest": "/$1.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
